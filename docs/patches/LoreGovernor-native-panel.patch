diff --git a/tests/native-panel.test.mjs b/tests/native-panel.test.mjs
new file mode 100644
index 0000000..27c1242
--- /dev/null
+++ b/tests/native-panel.test.mjs
@@ -0,0 +1,66 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { governedState, createNativePanelSync } from '../native-panel.mjs';
+
+const settings = { entryBooks: [{ name: '甲', assignments: { 1: 'always_on', 2: 'always_off', 3: '组' } }], toggleBooks: ['乙'] };
+test('书名与 UID、默认值、分组和整本开关遵循生成逻辑', () => {
+    const selection = { groups: { 甲: { 组: ['3'] } }, toggles: { 乙: false } };
+    assert.equal(governedState(settings, selection, '甲', 1, false), true);
+    assert.equal(governedState(settings, selection, '甲', 2, true), false);
+    assert.equal(governedState(settings, selection, '甲', 3, false), true);
+    assert.equal(governedState(settings, null, '甲', 3, true), false);
+    assert.equal(governedState(settings, selection, '甲', 4, true), null);
+    assert.equal(governedState(settings, selection, '丙', 1, true), null);
+    assert.equal(governedState(settings, selection, '乙', 1, true), false);
+    assert.equal(governedState(settings, null, '乙', 1, false), false);
+    assert.equal(governedState(settings, null, '乙', 1, true), true);
+});
+
+// 最小 DOM 替身：只支持适配层用到的接口；意外写入或派发事件会直接报错。
+class Element {
+    constructor(classes = '') {
+        this.attrs = {}; this.children = []; this.hidden = false;
+        const set = new Set(classes.split(' ').filter(Boolean));
+        this.classList = { contains: x => set.has(x), toggle: (x, on) => on ? set.add(x) : set.delete(x) };
+        const style = new Map();
+        this.style = { getPropertyValue: x => style.get(x)?.[0] ?? '', getPropertyPriority: x => style.get(x)?.[1] ?? '', setProperty: (x,v,p) => style.set(x,[v,p]), removeProperty: x => style.delete(x) };
+    }
+    setAttribute(k,v) { this.attrs[k] = v; }
+    getAttribute(k) { return this.attrs[k] ?? null; }
+    contains(el) { return this.children.includes(el); }
+    after(...els) { for (const el of els) { el.parent = this.parent; this.parent.children.push(el); } }
+    remove() { if (this.parent) this.parent.children = this.parent.children.filter(x => x !== this); }
+    addEventListener() {}
+    dispatchEvent() { throw Error('不应派发原生事件'); }
+}
+
+test('同步捕获状态、切聊天、取消接管、DOM 不兼容时恢复且不触发保存', async () => {
+    globalThis.MutationObserver = class { observe() {} disconnect() {} };
+    const row = new Element('disabledWIEntry'); row.setAttribute('uid', '1');
+    const toggle = new Element('fa-toggle-off'); toggle.parent = row;
+    const identity = new Element(); identity.setAttribute('data-current-world','甲'); identity.setAttribute('data-uid','1');
+    row.children = [toggle, identity];
+    row.querySelector = selector => selector.startsWith('div') ? toggle : identity;
+    const select = { value: '0' };
+    const document = { body: {}, addEventListener() {}, createElement: () => new Element(), querySelector: () => select, querySelectorAll: () => [row] };
+    let captured = { enabled: false };
+    let config = settings;
+    const schedule = createNativePanelSync({ document, worldNames: ['甲','乙'], getSettings: () => config, getSelection: () => null, getCaptured: () => captured });
+    await Promise.resolve();
+    assert.equal(toggle.hidden, true);
+    assert.equal(toggle.style.getPropertyValue('display'), 'none');
+    assert.equal(row.children[2].classList.contains('fa-toggle-off'), true);
+    captured = null; schedule(); await Promise.resolve();
+    assert.equal(row.children[2].classList.contains('fa-toggle-on'), true);
+    assert.equal(row.classList.contains('disabledWIEntry'), false);
+    config = { entryBooks: [], toggleBooks: [] }; schedule(); await Promise.resolve();
+    assert.equal(toggle.hidden, false);
+    assert.equal(row.children.length, 2);
+    assert.equal(row.classList.contains('disabledWIEntry'), true);
+    config = settings; schedule(); await Promise.resolve();
+    select.value = '1'; schedule(); await Promise.resolve();
+    assert.equal(toggle.hidden, false); // 书名不一致，绝不串 UID
+    assert.equal(row.children.length, 2);
+    select.value = '0'; identity.setAttribute('data-uid','9'); schedule(); await Promise.resolve();
+    assert.equal(row.children.length, 2);
+});
